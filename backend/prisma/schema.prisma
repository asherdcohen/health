// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainingPlans TrainingPlan[]
  workoutLogs   WorkoutLog[]
  aiAdjustments AIAdjustment[]

  @@map("users")
}

enum TrainingGoal {
  HALF_MARATHON
  MARATHON
  HALF_IRONMAN
  IRONMAN
}

enum SportType {
  RUN
  BIKE
  SWIM
  STRENGTH
  REST
}

enum WorkoutType {
  // Running
  EASY_RUN
  TEMPO_RUN
  INTERVAL_RUN
  LONG_RUN
  RECOVERY_RUN
  RACE_PACE_RUN

  // Cycling
  EASY_RIDE
  TEMPO_RIDE
  INTERVAL_RIDE
  LONG_RIDE
  RECOVERY_RIDE

  // Swimming
  EASY_SWIM
  TEMPO_SWIM
  INTERVAL_SWIM
  LONG_SWIM
  TECHNIQUE_SWIM

  // Other
  STRENGTH_TRAINING
  CROSS_TRAINING
  REST_DAY
}

enum IntensityZone {
  ZONE_1 // Recovery
  ZONE_2 // Endurance
  ZONE_3 // Tempo
  ZONE_4 // Threshold
  ZONE_5 // VO2 Max
}

model TrainingPlan {
  id            String       @id @default(uuid())
  userId        String
  goal          TrainingGoal
  startDate     DateTime
  raceDate      DateTime
  currentWeek   Int          @default(1)
  totalWeeks    Int
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedWorkouts  PlannedWorkout[]
  aiAdjustments    AIAdjustment[]

  @@map("training_plans")
}

model PlannedWorkout {
  id              String        @id @default(uuid())
  trainingPlanId  String
  weekNumber      Int
  dayOfWeek       Int           // 0 = Sunday, 6 = Saturday
  scheduledDate   DateTime
  sportType       SportType
  workoutType     WorkoutType
  targetDuration  Int?          // minutes
  targetDistance  Float?        // km
  targetPace      String?       // e.g., "5:30/km"
  intensityZone   IntensityZone?
  description     String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trainingPlan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  workoutLog   WorkoutLog?

  @@map("planned_workouts")
}

model WorkoutLog {
  id                String    @id @default(uuid())
  userId            String
  plannedWorkoutId  String?   @unique
  completedDate     DateTime
  sportType         SportType
  workoutType       WorkoutType

  // Actual workout data
  actualDuration    Int       // minutes
  actualDistance    Float?    // km
  actualPace        String?   // e.g., "5:30/km"

  // Performance metrics
  avgHeartRate      Int?      // bpm
  maxHeartRate      Int?      // bpm
  calories          Int?
  elevationGain     Float?    // meters

  // Subjective metrics
  rpe               Int?      // Rate of Perceived Exertion (1-10)
  feeling           String?   // How did you feel? (great, good, okay, tired, terrible)
  weatherConditions String?
  notes             String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedWorkout PlannedWorkout? @relation(fields: [plannedWorkoutId], references: [id])

  @@map("workout_logs")
}

model AIAdjustment {
  id             String   @id @default(uuid())
  userId         String
  trainingPlanId String
  weekNumber     Int

  // Analysis data
  analysisPrompt String   @db.Text
  aiResponse     String   @db.Text
  adjustments    Json     // Structured adjustments made

  // Metrics
  completionRate Float    // % of workouts completed
  avgRpe         Float?   // Average RPE for the week
  totalDistance  Float?   // Total km
  totalDuration  Int?     // Total minutes

  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingPlan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)

  @@map("ai_adjustments")
}
